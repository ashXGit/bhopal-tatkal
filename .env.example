# PostgreSQL connection string
DATABASE_URL="postgresql://tatkal:tatkal@localhost:5432/bhopal_tatkal?schema=public"
# Direct (non-pooled) connection for migrations. Locally: same as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://tatkal:tatkal@localhost:5432/bhopal_tatkal?schema=public"

# AI provider: "demo" (deterministic, no network) | "anthropic"
# If AI_PROVIDER is not "demo" but AI_API_KEY is missing, the app falls back to demo AI.
AI_PROVIDER="demo"
AI_API_KEY=""

# Used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Shows demo role switcher + "Demo Mode" banner
DEMO_MODE="true"
